/* ---------------- 缸体 ----------------
 * 内容区 300x256 + 3px 边框 = 306x262，居中 left 15 / top 66
 */
.tank {
  position: absolute;
  left: 15px;
  top: 66px;
  width: 300px;
  height: 256px;
  border-width: 3px;
  border-style: solid;
  border-color: #2c5a68;
  border-radius: 10px;
  overflow: hidden;
  background-color: #0b2230;
}

/* 水：上浅下深的两层，比单色更像缸 */
.water {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 300px;
  height: 256px;
  background-color: #0d2a36;
}

