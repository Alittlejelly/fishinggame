  background-color: #3d8fa8;
}

/* 水面下的第一层水比深处亮一点，缸才有纵深（纯色看着像一块黑板） */
.shine {
  position: absolute;
  left: 0px;
  top: 5px;
  width: 300px;
  height: 54px;
  background-color: #123a49;
}

/* 沙地：底下 28px，顶上一条亮线。只有一色的话和深水对比太小，缸看起来像没铺底 */
.sand-hi {
  position: absolute;
  left: 0px;
