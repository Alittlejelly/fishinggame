<template>
  <div class="page" style="background-color: {{sky}}; height: {{vh}}px;" onclick="onTap"
    ontouchstart="onTouchStart" ontouchend="onTouchEnd" onswipe="onSwipe">

    <!-- ==================== 地图选择 ==================== -->
    <div class="sel" if="{{phase === 'select'}}" style="height: {{vh}}px;">
      <div class="sel-head" style="margin-top: {{headTop}}px;">
        <text class="sel-title" style="font-size: {{cardS.titleSize}}px;">像素钓鱼</text>
        <!-- 副标题位置改成等级行：不额外占高度，点一下进等级页。
             窄屏字号放大到 22 之后，"总积分"三个字会把这一行顶出屏幕右边，
             所以窄屏只写数字（含义在等级页里有完整说明）。 -->
        <text class="sel-sub" if="{{!narrow}}" style="font-size: {{cardS.subSize}}px; color: {{lvColor}};" onclick="openLevel">LV {{lvLevel}} · {{lvTier}} · 总积分 {{lvTotal}}</text>
        <text class="sel-sub" if="{{narrow}}" style="font-size: {{cardS.subSize}}px; color: {{lvColor}};" onclick="openLevel">LV {{lvLevel}} · {{lvTier}} · {{lvTotal}}</text>
      </div>

      <!-- 七张地图一屏放不下：用 list 纵向滚动，滚到哪张点哪张。
           卡片尺寸/字号全从 cardS 读（见 setViewport / cardSizes）：
           宽屏 336x480 是设计稿原值，窄屏（手环 11）是放大版，一屏只露 4 张。 -->
      <list class="cards" style="height: {{cardsH}}px;">
        <list-item class="card-cell" type="map" for="{{maps}}" style="height: {{cardS.cellH}}px;">
          <div class="card" style="width: {{cardS.cardW}}px; height: {{cardS.cardH}}px; margin-left: {{cardS.cardMl}}px; border-color: {{$item.border}}; opacity: {{$item.opacity}};" onclick="selectMap($idx)">
            <!-- 像素小预览框 -->
            <div class="pv" style="width: {{cardS.pv}}px; height: {{cardS.pv}}px; background-color: {{$item.sky}};">
              <div class="pv-water" style="top: {{cardS.pvWaterTop}}px; width: {{cardS.pv}}px; height: {{cardS.pvWaterH}}px; background-color: {{$item.water}};"></div>
              <div class="pv-deep" style="top: {{cardS.pvDeepTop}}px; width: {{cardS.pv}}px; height: {{cardS.pvDeepH}}px; background-color: {{$item.deep}};"></div>
              <div class="pv-wave1" style="top: {{cardS.pvWaveY}}px; width: {{cardS.pvWaveW1}}px; background-color: {{$item.accent}};"></div>
              <div class="pv-wave2" style="left: {{cardS.pvWaveX2}}px; top: {{cardS.pvWaveY}}px; width: {{cardS.pvWaveW2}}px; background-color: {{$item.accent}};"></div>
              <div class="pv-tail" style="left: {{cardS.pvTailX}}px; top: {{cardS.pvTailY}}px; width: {{cardS.pvTailW}}px; height: {{cardS.pvTailH}}px; background-color: {{$item.fishFin}};"></div>
              <div class="pv-fish" style="left: {{cardS.pvFishX}}px; top: {{cardS.pvFishY}}px; width: {{cardS.pvFishW}}px; height: {{cardS.pvFishH}}px; background-color: {{$item.fishBody}};"></div>
              <div class="pv-eye" style="left: {{cardS.pvEyeX}}px; top: {{cardS.pvEyeY}}px; width: {{cardS.pvEyeS}}px; height: {{cardS.pvEyeS}}px;"></div>
              <!-- 未解锁：预览图压一层暗色 + 一把锁 -->
              <div class="pv-lock" if="{{$item.locked}}" style="width: {{cardS.pv}}px; height: {{cardS.pv}}px;">
                <text class="pv-lock-t" style="width: {{cardS.pv}}px; font-size: {{cardS.pvLockT}}px;">锁</text>
              </div>
            </div>
            <div class="card-info" style="width: {{cardS.infoW}}px;">
              <text class="card-name" style="font-size: {{cardS.nameSize}}px; color: {{$item.accent}};">{{$item.title}}</text>
              <text class="card-desc" style="font-size: {{cardS.descSize}}px; margin-top: {{cardS.descMt}}px; color: {{$item.descColor}};">{{$item.descLine}}</text>
              <!-- 星级和最高分：宽屏并排一行；窄屏字大放不下，改竖排两行 -->
              <div class="card-row" style="width: {{cardS.infoW}}px; height: {{cardS.rowH}}px; margin-top: {{cardS.rowMt}}px; flex-direction: {{cardS.rowDir}}; align-items: {{cardS.rowAlign}};">
                <text class="card-star" style="font-size: {{cardS.starSize}}px; color: {{$item.accent}};">{{$item.stars}}</text>
                <text class="card-best" style="font-size: {{cardS.bestSize}}px; margin-left: {{cardS.bestMl}}px;">{{$item.bestLine}}</text>
              </div>
            </div>
          </div>
        </list-item>
      </list>

      <!-- 底部入口：等级 / 鱼缸 / 关于（居中胶囊，跟手环系统里那种按钮一致）。
           宽屏（336x480）一行三个，总宽 324。
           窄屏（手环 11）改上下两行：上「等级 + 鱼缸」，下「关于」。
           三个挤在 212 物理宽里，每个只有 55~72 物理宽，高 52 也没用 ——
           手指横着放不下，按「关于」会蹭到鱼缸。分行后每个宽 82~100 物理、高 52 物理。
           ★ 两块「关于」是同一颗按钮的两种摆法，靠 cardS.twoRows 二选一，
             改文案/配色时要两边一起改。 -->
      <div class="entry-wrap" style="margin-top: {{cardS.entryMt}}px;">
        <div class="entry-row">
          <div class="entry" style="width: {{cardS.entryW}}px; height: {{cardS.entryH}}px; border-radius: {{cardS.entryR}}px; border-color: {{lvColor}};" onclick="openLevel">
            <text class="entry-t" style="width: {{cardS.entryTextW}}px; font-size: {{cardS.entrySize}}px; color: {{lvColor}};">等级</text>
          </div>
          <div class="entry" style="width: {{cardS.entryWBig}}px; height: {{cardS.entryH}}px; border-radius: {{cardS.entryR}}px; border-color: #f7c948;" onclick="openTank">
            <text class="entry-t3" style="width: {{cardS.entryTextWBig}}px; font-size: {{cardS.entrySize}}px; color: #f7c948;">{{cardS.bigLabel}}</text>
          </div>
          <div class="entry" if="{{!cardS.twoRows}}" style="width: {{cardS.entryWAbout}}px; height: {{cardS.entryH}}px; border-radius: {{cardS.entryR}}px; border-color: {{accent}};" onclick="openAbout">
            <text class="entry-t3" style="width: {{cardS.entryTextWAbout}}px; font-size: {{cardS.entrySize}}px; color: {{accent}};">关于</text>
          </div>
        </div>
        <!-- 窄屏第二行：关于 -->
        <div class="entry-row" if="{{cardS.twoRows}}" style="margin-top: {{cardS.entryGap}}px;">
          <div class="entry" style="width: {{cardS.entryWAbout}}px; height: {{cardS.entryH}}px; border-radius: {{cardS.entryR}}px; border-color: {{accent}};" onclick="openAbout">
            <text class="entry-t3" style="width: {{cardS.entryTextWAbout}}px; font-size: {{cardS.entrySize}}px; color: {{accent}};">关于</text>
          </div>
        </div>
      </div>
      <!-- 底部安全区：**必须是一个占位的空 div，不能写成 .sel 的 padding-bottom**。
           Vela 的 div 是 content-box（CSS 默认），height 只算内容区 ——
           `.sel { height:824; padding-bottom:84 }` 的元素外框其实是 908，
           子节点却仍然排在 0~824 里，于是三个胶囊正好贴在屏幕最下沿、下面一点余量都没有。
           这几版 padB 从 22 加到 48 再到 84 在真机上毫无变化，就是这个原因。
           现在用一个 84 高的空 div 顶住，列表（flex-grow:1）自己让位。 -->
      <div class="sel-gap" style="height: {{cardS.padB}}px;"></div>
      <!-- 只保留"点了锁定地图"这一句功能提示；常驻的操作说明去掉了（底部留白更干净） -->
      <!-- 提示浮在最下面：绝对定位，不占流 —— 占流的话这一行 22 高会从列表里扣掉，
           列表少露的那截正好是"下面还有地图"的暗示 -->
      <text class="sel-foot-lock" if="{{lockMsg}}" style="bottom: {{cardS.lockBottom}}px;">{{lockMsg}}</text>
    </div>

    <!-- ==================== 游戏场景 ==================== -->
    <!--
      所有像素块都直接挂在 .page 下、各自带绝对坐标。
      早先把精灵包在 .spr 容器里（容器没有宽高），真机上整组不渲染，
      鱼 / 船 / 钩全部消失，只剩波浪和水底 —— 所以这里一律扁平化。
    -->
    <!-- 游戏场景只在"局中 / 结算"出现（关于页不需要它，省一次整屏重建） -->
    <block if="{{phase === 'playing' || phase === 'over'}}">
      <!--
        兜底水体：一个静态纯色块，垫在全屏底图下面。万一某版固件不认 336x480 的
        大图，天空/水的分界至少还在，鱼和船仍然看得见，游戏不至于变成黑屏。
        正常情况下它被底图完全盖住，不产生任何视觉效果。
      -->
      <div class="wx" style="background-color: {{water}}; height: {{wxH}}px;"></div>

      <!--
        静态场景（天空 / 远岸 / 月亮 / 水面线 / 浪花 / 水草 / 礁石）在构建期烘成一张
        336x480 的全屏位图（tools/gen_sprites.mjs）。原来这里是 60 多个装饰 div，
        切地图时要整批销毁重建，手环上会明显顿住；现在整个场景只有一个 image，
        换地图只是换一个 src 字符串，节点数不变。
      -->
      <image class="spr" src="{{bgSrc}}" style="left: 0px; top: 0px; width: 336px; height: {{bgH}}px;" />

      <!--
        水底景观（深水带 + 水底）单独一张，贴着屏幕底边。
        窄长屏（手环 11）上它跟着 vh 往下走，中间那段纯水色由上面的 .wx 抻开 ——
        所以背景不会被纵向拉伸，像素格还是正方格。
      -->
      <image class="spr" src="{{bedSrc}}" style="left: 0px; top: {{bedTop}}px; width: 336px; height: 124px;" />

      <!--
        精灵全部是构建期烘好的位图（tools/gen_sprites.mjs），一个精灵 = 一个 image 节点。
        一帧只改 8~10 个 left/top，比之前每帧重建 200 多个像素块快一个量级。
      -->
      <image class="spr" src="{{f1src}}" style="left: {{f1x}}px; top: {{f1y}}px; width: {{f1w}}px; height: {{f1h}}px; opacity: {{f1op}};" />
      <image class="spr" src="{{f2src}}" style="left: {{f2x}}px; top: {{f2y}}px; width: {{f2w}}px; height: {{f2h}}px; opacity: {{f2op}};" />
      <image class="spr" src="{{f3src}}" style="left: {{f3x}}px; top: {{f3y}}px; width: {{f3w}}px; height: {{f3h}}px; opacity: {{f3op}};" />
      <!-- 第 4 条只在窄长屏（手环 11）出现：深水区比设计稿高一倍，3 条太稀 -->
      <image class="spr" if="{{f4on}}" src="{{f4src}}" style="left: {{f4x}}px; top: {{f4y}}px; width: {{f4w}}px; height: {{f4h}}px; opacity: {{f4op}};" />

      <!-- 星标鱼头顶的 ★：金色鱼 + 这颗星，一眼知道"这条要拉力度条" -->
      <text class="star-tag" if="{{starOn}}" style="left: {{starX}}px; top: {{starY}}px;">★</text>

      <!-- 稀有金鱼（只在出场时挂节点） -->
      <image class="spr" if="{{rareOn}}" src="{{rSrc}}" style="left: {{rX}}px; top: {{rY}}px; width: {{rW}}px; height: {{rH}}px; opacity: {{rOp}};" />

      <!-- 船 + 渔夫 + 鱼竿（一张位图，整体随船移动；掉头时换成镜像那张，竿跟着转向） -->
      <image class="spr" src="{{rigSrc}}" style="left: {{rigX}}px; top: {{rigTop}}px; width: {{rigImgW}}px; height: {{rigImgH}}px;" />

      <!-- 钓线 -->
      <div class="line" style="left: {{lineX}}px; top: {{lineTop}}px; height: {{lineH}}px; opacity: {{lineOp}};"></div>

      <!-- 鱼钩 -->
      <image class="spr" src="/common/sprites/hook.png" style="left: {{hookLX}}px; top: {{hookY}}px; width: {{hookW}}px; height: {{hookH}}px; opacity: {{hookOp}};" />

      <!-- 加分飘字 -->
      <text class="gain" if="{{showGain}}" style="left: {{gainX}}px; top: {{gainY}}px; color: {{accent}};">{{gainText}}</text>

      <!-- HUD -->
      <!-- 剩余时间条 + HUD。两样都贴着屏幕顶：480 上正好（y=0 / y=8），
           胶囊屏上会被屏顶的半圆吃掉 —— 4px 的条只剩中间一道弧，分数和倒计时
           各被切掉一个数字。窄屏的 y / 宽度 / 字号全由 hudSizes() 按圆角几何算。 -->
      <div class="bar-bg" style="left: {{hudS.barX}}px; top: {{hudS.barTop}}px; width: {{hudS.barW}}px; height: {{hudS.barH}}px; border-radius: {{hudS.barR}}px;">
        <div class="bar-fill" style="width: {{barW}}px; height: {{hudS.barH}}px; border-radius: {{hudS.barR}}px; background-color: {{accent}};"></div>
      </div>
      <div class="hud" style="top: {{hudS.top}}px; height: {{hudS.h}}px; padding-left: {{hudS.padX}}px; padding-right: {{hudS.padX}}px;">
        <text class="hud-score" style="font-size: {{hudS.scoreSize}}px;">{{score}}</text>
        <text class="hud-combo" if="{{combo > 1}}" style="font-size: {{hudS.comboSize}}px; color: {{accent}};">{{hudS.comboPrefix}}{{comboText}}</text>
        <text class="hud-time" style="font-size: {{hudS.timeSize}}px;">{{timeLeft}}s</text>
      </div>
      <text class="hint" if="{{phase === 'playing'}}" style="top: {{hintTop}}px;">轻点放钩 · 右滑返回</text>

    </block>

    <!-- ==================== 星标鱼 · 拉鱼力度条 ====================
         只有钓到星标鱼才会出现（reelOn）。普通鱼一钩入护，不打断节奏。
         参照星露谷那根竖条：左边一列刻度，中间是往上顶的柱子，
         柱子穿过绿色区间就累计进度，累计够了鱼才拉得上来。
    -->
    <div class="reel" if="{{reelOn}}" style="height: {{vh}}px;">
      <div class="reel-head">
        <text class="reel-title">★ 星标鱼上钩</text>
        <text class="reel-sub">按住往上拉 · 松手下滑 · 跟住绿框</text>
      </div>

      <div class="reel-body">
        <!-- 左刻度 -->
        <div class="reel-scale">
          <div class="reel-tick" for="{{reelTicks}}"></div>
        </div>
        <!-- 轨道：绿框 = 鱼的位置，自己会上下游；柱子从底部顶上来 -->
        <div class="reel-track">
          <div class="reel-zone" style="top: {{reelZoneTop}}px; height: {{reelZoneH}}px; border-color: {{reelColor}};"></div>
          <div class="reel-fill" style="top: {{reelTop}}px; height: {{reelFill}}px;">
            <div class="reel-cap"></div>
          </div>
        </div>
        <!-- 正在被拉的那条星标鱼：纵向跟着绿框走，一眼看出"它在游" -->
        <image class="reel-fish" src="{{reelSrc}}" style="width: {{reelFishW}}px; height: {{reelFishH}}px; margin-top: {{reelFishTop}}px;" />
      </div>

      <div class="reel-bar">
        <div class="reel-bar-fill" style="width: {{reelProg}}px; background-color: {{reelBarColor}};"></div>
      </div>
      <text class="reel-tip" style="color: {{reelColor}};">{{reelTip}}</text>
    </div>

    <!-- ==================== 结算 ====================
         尺寸/字号全部走 pS（common/pagesize.js 的 panelSizes）：
         宽屏 272/16 是设计稿原值，手环 11 放大到 300/24（物理 189 宽、正文 15 物理像素）。
         原来照 480 写死，212 宽的真机上整块只有 172 物理宽、正文 10 物理 ——"结算栏太小"。 -->
    <div class="mask" if="{{phase === 'over'}}" style="height: {{vh}}px;">
      <div class="panel" style="width: {{pS.w}}px; padding-top: {{pS.padT}}px; padding-bottom: {{pS.padB}}px; border-color: {{accent}};">
        <text class="panel-title" style="width: {{pS.barW}}px; font-size: {{pS.titleSize}}px; letter-spacing: {{pS.titleLs}}px; color: {{accent}};">时间到</text>
        <text class="panel-score" style="width: {{pS.barW}}px; font-size: {{pS.scoreSize}}px; margin-top: {{pS.scoreMt}}px;">{{score}}</text>
        <text class="panel-line" style="width: {{pS.barW}}px; font-size: {{pS.lineSize}}px; margin-top: {{pS.lineMt}}px;">钓到 {{caught}} 条 · {{mapLabel}}</text>
        <text class="panel-gain" style="width: {{pS.barW}}px; font-size: {{pS.gainSize}}px; margin-top: {{pS.gainMt}}px;">积分 +{{score}} · 总 {{lvTotal}}</text>
        <div class="panel-bar" style="width: {{pS.barW}}px; height: {{pS.barH}}px; margin-top: {{pS.barMt}}px;">
          <div class="panel-fill" style="width: {{lvBarW}}px; height: {{pS.barH}}px; background-color: {{lvColor}};"></div>
        </div>
        <text class="panel-lvup" if="{{lvUp}}" style="width: {{pS.barW}}px; font-size: {{pS.lvupSize}}px; margin-top: {{pS.lvupMt}}px; color: {{lvColor}};">升级！LV {{lvLevel}} · {{lvTier}}</text>
        <text class="panel-unlock" if="{{lvNewMap}}" style="width: {{pS.barW}}px; font-size: {{pS.unlockSize}}px; margin-top: {{pS.unlockMt}}px;">★ 解锁 {{lvNewMap}} ★</text>
        <text class="panel-best" if="{{isNewBest}}" style="width: {{pS.barW}}px; font-size: {{pS.bestSize}}px; margin-top: {{pS.bestMt}}px;">★ 新纪录 ★</text>
        <text class="panel-best" else style="width: {{pS.barW}}px; font-size: {{pS.bestSize}}px; margin-top: {{pS.bestMt}}px;">最高 {{bestOfMap}} 分</text>
        <!-- 星标鱼：只有钓到星标鱼，面板上才长出这一块。
             普通鱼连按钮都没有 —— "只有星标鱼能放进鱼缸"这条规则写在模板上，
             而不是靠点进去再报错。 -->
        <div class="star-box" if="{{pendingStar}}" style="width: {{pS.starW}}px; margin-top: {{pS.starMt}}px; padding-top: {{pS.starPadT}}px; padding-bottom: {{pS.starPadB}}px;">
          <div class="star-row">
            <image class="star-img" src="{{pendingSrc}}" style="width: {{pS.starImgW}}px; height: {{pendingH}}px; margin-right: {{pS.starImgMr}}px;" />
            <text class="star-name" style="width: {{pS.starNameW}}px; font-size: {{pS.starNameSize}}px;">{{pendingLabel}}</text>
          </div>
          <div class="star-btn" if="{{!tankGot}}" onclick="putInTank" style="width: {{pS.starBtnW}}px; height: {{pS.starBtnH}}px; margin-top: {{pS.starBtnMt}}px; border-radius: {{pS.starBtnR}}px;">
            <text class="star-btn-t" style="width: {{pS.starBtnTW}}px; font-size: {{pS.starBtnSize}}px;">放入鱼缸</text>
          </div>
          <text class="star-done" else style="width: {{pS.starW}}px; font-size: {{pS.starDoneSize}}px; margin-top: {{pS.starDoneMt}}px;">已入缸 · 鱼缸 {{tankCount}} / {{tankSlots}}</text>
        </div>
        <div class="btns" style="margin-top: {{pS.btnMt}}px;">
          <div class="btn" style="width: {{pS.btnW}}px; height: {{pS.btnH}}px; margin-left: {{pS.btnMx}}px; margin-right: {{pS.btnMx}}px; background-color: {{accent}};" onclick="restart">
            <text class="btn-t" style="width: {{pS.btnTxtW}}px; font-size: {{pS.btnSize}}px;">再来一局</text>
          </div>
          <div class="btn-ghost" style="width: {{pS.btnW}}px; height: {{pS.btnH}}px; margin-left: {{pS.btnMx}}px; margin-right: {{pS.btnMx}}px; border-color: {{accent}};" onclick="backToSelect">
            <text class="btn-t" style="width: {{pS.btnTxtW}}px; font-size: {{pS.btnSize}}px; color: {{accent}};">换地图</text>
          </div>
        </div>
      </div>
    </div>

  </div>
</template>

<script>
import storage from '@system.storage'
import router from '@system.router'
import brightness from '@system.brightness'
import { levelInfo, LEVEL_KEY } from '../../common/level.js'
import { STARS, TANK_KEY, starOf, tankId, tankEntry, parseTank } from '../../common/star.js'
import { SCREEN, DESIGN_H, screenH, probeScreen, onScreen } from '../../common/screen.js'
import { cardSizes, isNarrow, shortDesc, titleOf, bestOf } from '../../common/cardsize.js'
import { panelSizes, hudSizes } from '../../common/pagesize.js'
import { TEST, TEST_SEED_KEY } from '../../common/dev.js'

/* ---------------- 画布常量 ----------------
 * 横向：恒定按设计稿 336（manifest 的 designWidth 会把 px 等比缩到真实宽度）。
 * 纵向：PAGE_H / GROUND_Y / HOOK_BOTTOM / BED_TOP 都随真实屏幕变，
 *       由 applyLayout() 在 onInit 里按 src/common/screen.js 的画布高重算。
 *       小米手环 10 Pro（336x480）→ 480，数值和设计稿一模一样；
 *       小米手环 11（212x520）→ 824，多出来的 344 全给深水区。
 */
const DESIGN_W = 336
let PAGE_H = 480                  // 画布高（设计单位），运行时按设备改
const WATER_TOP = 176             // 水面 y（抬高、压缩空水域 → 视角更近）；水面位置不随屏幕变
let GROUND_Y = 430                // 水底 y = PAGE_H - GROUND_H
const GROUND_H = 50               // 水底层厚度（水底景观图的下半部分）
const BED_H = 124                 // 水底景观图总高 = 深水带 74 + 水底 50
const BG_H = 356                 // 上半段背景图高 = 设计稿 480 - BED_H(124)，写死：图是按 480 切的
let BED_TOP = 356                 // 水底景观图上沿 = PAGE_H - BED_H（窄长屏会更低）
const TICK = 33                // 一帧 33ms ≈ 30fps（位图精灵后每帧只写 7 次属性，够轻）
const STEP = TICK / 40         // 所有速度都按"每 40ms"调的，换帧率时用它保持手感不变
const UNIT = 5                 // 船/渔夫/钩的像素格（和鱼同格，整屏像素网格统一）
const FUNIT = 5                // 鱼同样 5px 一格
const BEST_KEY = 'band_pixel_fish_'

const BOAT_TOP = WATER_TOP - 34   // 船精灵顶部，船底吃水 6px
const RIG_DX = 16                 // 渔夫相对船左边缘
const RIG_DY = -45                // 渔夫相对船顶部
// 竿尖 = 竿最后一段像素块的中心/底边（朝右时那块在 x 106..111、y -43..-40）
// 线挂在块的中心线上、从块底边往下走，才看得出"线是接在竿上的"
const ROD_TIP_DX = 108            // 竿尖 x（船头朝右），= RIG_DX + 92；gen_sprites 会校验
const ROD_TIP_DX_L = 12           // 同一块左右镜像后的竿尖 x（船头朝左），= RIG_IMG_DX + 2
const ROD_TIP_DY = RIG_DY + 5     // -40：竿末块底边 y（相对船顶部）
const HOOK_DX = 18                // 钩左边缘相对竿尖：让钩柄中心正好落在线上
const HOOK_REST = WATER_TOP + 14  // 收线后钩的静止 y（吊在船底下方）
let HOOK_BOTTOM = 394             // 钩能放到的最深处 = GROUND_Y - 36

// 钓具位图（tools/gen_sprites.mjs 烘出来的包围盒，相对 (boatX, BOAT_TOP)）
const RIG_IMG_W = 101
const RIG_IMG_H = 96
const RIG_IMG_DX = 10
const RIG_IMG_DY = -43
const RIG_IMG_TOP = BOAT_TOP + RIG_IMG_DY // 位图的页面 y（常量，不用每帧算）
const LINE_TOP = BOAT_TOP + ROD_TIP_DY    // 鱼线起点 = 竿尖
// 船头朝右 / 朝左两张钓具位图（gen_sprites 用同一份像素块左右镜像烘出来）
const RIG_SRC_R = '/common/sprites/rig.png'
const RIG_SRC_L = '/common/sprites/rig-l.png'
const SWIPE_DX = 56               // 右滑返回：横向位移阈值（px，按 336 宽设计）
const SWIPE_DY = 44               // 右滑返回：纵向偏移上限，太斜的滑动不算

const FISH_TOP = WATER_TOP + 56   // 鱼群活动带上沿
const FISH_PAD = 22               // 鱼群活动带下边距
const FISH_N = 3                  // 屏上同时游几条（渲染槽写死 3 组字段）
const FISH_N_TALL = 4             // 窄长屏多一条：深水区高了一倍，3 条太稀疏

/* ---------------- 多屏纵向布局 ----------------
 * 水面固定在 176（船、竿、钩、力度条都围着它画，动它会全乱），
 * 多出来的高度全部给"水面以下"：鱼群活动带变深、水底景观贴着屏幕底边。
 * applyLayout() 在 onInit 里调一次，读到真实屏幕尺寸后可能再调一次。
 */
function applyLayout() {
  PAGE_H = screenH()
  GROUND_Y = PAGE_H - GROUND_H
  HOOK_BOTTOM = GROUND_Y - 36
  BED_TOP = PAGE_H - BED_H
}

/* ---------------- 鱼的出场 / 入场 ----------------
 * 老写法是"钓一条、当场在同一条泳道上换一条新的"，鱼凭空出现，很生硬。
 * 现在拆成三段，肉眼看到的是"这条鱼被提走了，过一会儿从边上又游进来一条"：
 *   1) 被钓到   → hop 帧内跟着钩子往水面提、边提边淡出（同步收线速度 17px/帧）
 *   2) 空档     → 这条泳道先空着 gap 帧（1.1~2.0 秒），不立刻补位
 *   3) 游进来   → 贴着屏边起步，8 帧淡入 + 26 帧里从 35% 加速到全速
 * 注意：这里全程不出屏（left 永远落在 0..336-w），
 * 一旦让精灵框越过 336，整页又会变成可滚动的（v2.4 的滑动 bug）。
 */
const FISH_RISE = 17              // 被提走时每帧上升 = 钩子的收线速度
const FISH_HOP = 7                // 提走动画共几帧（102px，正好从水底提到水面附近）
const FISH_GAP = 34               // 空档帧数下限 ≈1.1s
const FISH_GAP_RND = 26           // 再加 0~26 帧 ≈0.9s
const FISH_WARM = 26              // 入场加速：26 帧内从 35% 加到全速
const FISH_FADE = 0.14            // 入场淡入速度（每帧 +0.14 → 约 8 帧到底）

/* ---------------- 星标鱼 & 拉鱼力度条 ----------------
 * 星标鱼是本图的招牌猎物（每图一条，见 src/common/star.js），
 * 钓上来的那一瞬间不直接入护，先进 reel 阶段玩力度条：
 *   按住屏幕 → 柱子往上升，松手 → 往下沉；
 *   柱顶停进绿色区间就累计，累计够 REEL_NEED 毫秒算拉上来，
 *   超过 REEL_LIMIT 还没拉上来，鱼挣脱跑掉（这一局不再出现）。
 * 普通鱼不会触发这套逻辑，一钩一个准。
 */
const STAR_FIRST = 210            // 开局约 7 秒后星标鱼才可能出现（帧数）
const STAR_JITTER = 90            // 再加 0~3 秒随机，免得每局都同一时刻冒出来
const REEL_H = 246                // 力度条轨道内部高度（像素，和 .reel-track 的内容高对齐）
const REEL_UP = 4.8               // 按住时每帧上升
const REEL_DOWN = 5.8             // 松手时每帧下沉
const REEL_ZONE = 52              // 绿色目标区高度（原来 92：框大得像口井，站住不动就过了）
const REEL_DRIFT = 0.036          // 绿区每帧的相位增量（≈ 5.7 秒一个来回，鱼在里面上下游）
const REEL_NEED = 2000            // 在绿区里累计多少毫秒算成功
const REEL_DRAIN = 0.6            // 柱顶不在绿区时，进度每毫秒倒扣多少（相对累计速度）
const REEL_LIMIT = 16000          // 整段拉扯的总时限，超时鱼跑掉
const TANK_SLOTS = STARS.length   // 鱼缸位数 = 地图张数

// 每张地图的静态场景位图（每条 = 一张 336x480 全屏 PNG，构建期烘好）
// 加地图时只要往 THEMES 里加一项，这里按同样的顺序补一行即可（tools/preview.mjs 也会读它）
// 每张地图的背景拆成两张位图：
//   bg-{i}.png  上半段（天空 + 远岸 + 水面线 + 浪花 + 浅水），336 x 356，贴顶
//   bed-{i}.png 水底景观（深水带 + 水底），336 x 124，贴底
// 中间那段"纯水色"用 .wx 那个纯色块填 —— 屏越高填得越多，
// 所以同一份资源在 336x480 和 212x520 上都能铺满，且像素不被拉伸。
const BG_SRC = [
  '/common/sprites/bg-0.png',
  '/common/sprites/bg-1.png',
  '/common/sprites/bg-2.png',
  '/common/sprites/bg-3.png',
  '/common/sprites/bg-4.png',
  '/common/sprites/bg-5.png',
  '/common/sprites/bg-6.png'
]
const BED_SRC = [
  '/common/sprites/bed-0.png',
  '/common/sprites/bed-1.png',
  '/common/sprites/bed-2.png',
  '/common/sprites/bed-3.png',
  '/common/sprites/bed-4.png',
  '/common/sprites/bed-5.png',
  '/common/sprites/bed-6.png'
]

/* ---------------- 像素精灵（. 透明） ----------------
 * 鱼：  B 身体 / D 背纹与斑点 / R 暖色带（红腹、锦鲤斑） / W 腹部
 *       F 鳍（尾鳍、背鳍、腹鳍） / E 眼睛
 * 船：  M 舷缘 / B 船体 / D 深色船底
 * 渔夫：H 草帽 / S 皮肤 / E 眼 / C 衣服 / P 裤 / K 鞋 / R 鱼竿
 *
 * 八种猎物，每张地图都有自己的"招牌生物"，换地图要能一眼看出换了地方：
 *   fry     小银鱼  —— 细长、叉尾，池塘里最多
 *   trout   虹鳟    —— 橄榄背、红侧腹、叉尾、黑斑
 *   bass    鲈鱼    —— 高背厚身、大嘴，压秤
 *   puffer  河豚    —— 圆球身 + 一圈刺
 *   koi     锦鲤    —— 白底红斑、大飘尾
 *   catfish 鲶鱼    —— 长身宽头，尾巴圆
 *   jelly   水母    —— 伞盖 + 发光核 + 触须
 *   crab    螃蟹    —— 正面壳 + 两只钳 + 六条腿
 *   icefish 冰鱼    —— 极细长 + 冰晶背鳍（极光冰海）
 *   octopus 章鱼    —— 圆头 + 两只大眼 + 六条卷须（紫雾藻林）
 *   starfish 海星   —— 五角星，趴在熔岩海沟的石头上
 *   ray     鳐鱼    —— 菱形大翼 + 细长鞭尾（星海之底）
 */
